// Same HUD decision as frame_gen_ui.comp, with the exact generated texel as the other result.
#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0,rgba8) uniform writeonly image2D output_img;
layout(binding=1) uniform texture2D color_tex;
layout(binding=2) uniform texture2D hudless_tex;
layout(binding=3) uniform texture2D generated_tex;
layout(push_constant) uniform Constants { ivec2 size; };
void main() {
    const ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(pixel.x>=size.x||pixel.y>=size.y)return;
    const vec3 color=texelFetch(color_tex,pixel,0).rgb;
    const vec3 hudless=texelFetch(hudless_tex,pixel,0).rgb;
    const vec3 difference=abs(color-hudless);
    const bool ui=max(difference.r,max(difference.g,difference.b))>1.5/255.0;
    imageStore(output_img,pixel,ui?vec4(color,1.0):texelFetch(generated_tex,pixel,0));
}
